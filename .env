# ============================================================
# magic-api 运行环境配置 (.env)
# ------------------------------------------------------------
# 由 docker-compose.yml 通过 env_file 注入容器环境；
# Spring Boot 宽松绑定(Wide Binding)把变量映射为配置项：
#   SERVER_PORT              -> server.port
#   MAGIC_API_WEB            -> magic-api.web
#   MAGIC_API_RESOURCE_*     -> magic-api.resource.*
#   MAGIC_API_SECURITY_*     -> magic-api.security.*
#   ... 其余 MAGIC_API_* 依次类推(点号转下划线、全小写)
#
# 修改后执行 `docker compose up -d` 即可生效，无需重新构建镜像。
# 安全提示：本文件含后台登录口令，生产环境请改为强密码，
#           并避免把真实口令提交到公开仓库。
# ============================================================

# ---- 镜像 / 容器 ----
MAGIC_API_IMAGE_TAG=2.2.2
CONTAINER_NAME=magic-api
TZ=Asia/Shanghai

# ---- 端口 (宿主机:容器) ----
HOST_PORT=9999
SERVER_PORT=9999

# ---- magic-api 基础 ----
MAGIC_API_WEB=/magic/web
MAGIC_API_PREFIX=
MAGIC_API_BANNER=true
MAGIC_API_THROW_EXCEPTION=false
MAGIC_API_SUPPORT_CROSS_DOMAIN=true
MAGIC_API_SHOW_SQL=true
MAGIC_API_COMPILE_CACHE_SIZE=500
MAGIC_API_PERSISTENCE_RESPONSE_BODY=true
MAGIC_API_AUTO_IMPORT_MODULE=db
MAGIC_API_ALLOW_OVERRIDE=false

# ============================================================
# 数据库配置（接口脚本 / 备份 入库存储；需 resource.type=database）
# ------------------------------------------------------------
# magic-api 没有「配置即注册」的命名数据源：具名数据源要在 Web UI 中建立并持久化。
# 主数据源(JDBC)由 Spring Boot 标准属性 spring.datasource.* 注入，供 db 模块/SQL 接口使用。
# 详细说明见 DOCKER.md「数据库配置」章节与 config/database-*.yml.example。
# ============================================================

# ---- 1) 主数据源 JDBC 连接（Spring Boot 标准属性） ----
# MySQL 示例：     jdbc:mysql://<host>:3306/magic_api?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
# PostgreSQL 示例：jdbc:postgresql://<host>:5432/magic_api
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# MySQL 用 com.mysql.cj.jdbc.Driver；PostgreSQL 用 org.postgresql.Driver
SPRING_DATASOURCE_DRIVER_CLASS_NAME=

# ---- 2) DataSource 自动配置开关 ----
# 留空        = 启用（配合上面 4 项建立主数据源，用于 database 存储模式）
# 填下方类名  = 排除（纯 file 模式、不连库时使用，避免无 url 启动报错）
DATASOURCE_EXCLUDE=org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration

# ---- 3) 接口存储 ----
MAGIC_API_RESOURCE_TYPE=file
# 容器内路径（magic-api 读取脚本/分组/数据源的位置）
MAGIC_API_RESOURCE_LOCATION=/data/magic-api
# 宿主机挂载路径（生成容器时绑定挂载到上面的容器内路径）
#   - 默认值 ./data/magic-api 即本项目 data/magic-api 目录（已纳入 git，便于更新资源包）
#   - 想换盘/换目录时，改这里即可，例如 D:/magic-api-data
MAGIC_API_DATA_DIR=./data/magic-api
MAGIC_API_RESOURCE_READONLY=false
MAGIC_API_RESOURCE_PREFIX=magic-api
MAGIC_API_RESOURCE_TABLE=magic_api_file
# database 模式时引用的具名数据源（必须是 Web UI 中建立的同名数据源，如 default）
MAGIC_API_RESOURCE_DATASOURCE=

# ---- 4) 备份（需 type=database，引用同名数据源） ----
MAGIC_API_BACKUP_ENABLE=false
MAGIC_API_BACKUP_MAX_HISTORY=-1
MAGIC_API_BACKUP_TABLE=magic_api_backup
MAGIC_API_BACKUP_DATASOURCE=

# ---- 后台 / 编辑器登录（务必修改为强密码!） ----
MAGIC_API_SECURITY_USERNAME=admin
MAGIC_API_SECURITY_PASSWORD=admin123

# ---- 集群远程推送秘钥（留空不开启） ----
MAGIC_API_SECRET_KEY=

# ---- 分页 ----
MAGIC_API_PAGE_PARAM=page
MAGIC_API_SIZE_PARAM=size
MAGIC_API_DEFAULT_PAGE=1
MAGIC_API_DEFAULT_SIZE=10
MAGIC_API_MAX_PAGE_SIZE=-1

# ---- SQL 缓存 ----
MAGIC_API_CACHE_ENABLE=false
MAGIC_API_CACHE_CAPACITY=10000
MAGIC_API_CACHE_TTL=-1

# ---- 备份配置已合并至上方「数据库配置」区块（MAGIC_API_BACKUP_*） ----

# ---- 响应 code ----
MAGIC_API_CODE_SUCCESS=1
MAGIC_API_CODE_INVALID=0
MAGIC_API_CODE_EXCEPTION=-1

# ---- 逻辑删除 ----
MAGIC_API_LOGIC_DELETE_COLUMN=is_valid
MAGIC_API_LOGIC_DELETE_VALUE=0
